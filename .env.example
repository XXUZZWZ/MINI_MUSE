# Copy this file to .env and fill in values locally. Do not commit .env.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=use-an-app-password
IMAP_MAILBOX=INBOX

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=use-an-app-password
DIGEST_TO=you@example.com

# Sending requires both MINMUSE_SEND_ENABLED=true and the --send CLI flag.
MINMUSE_SEND_ENABLED=false
MINMUSE_MAX_MESSAGES=20

# Optional OpenAI-compatible endpoint. Leave blank for deterministic offline rules.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
